<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="zzk.mapper.BlogMapper">
    <resultMap id="blogMap" type="zzk.entity.Blog" autoMapping="true">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="title" jdbcType="VARCHAR" property="title"/>
        <association property="author" column="author_id" select="selectUserByUserId"/>
        <association property="comments" column="id" select="selectCommentByBlogId" fetchType="lazy"/>
    </resultMap>
    <resultMap id="commentMap" type="zzk.entity.Comment" autoMapping="true">
        <result column="content_str" jdbcType="VARCHAR" property="contentStr"/>
        <association property="author" column="author_id" select="selectUserByUserId"/>
        <association property="blog" column="blog_id" select="selectBlogById"/>
    </resultMap>
    <select id="selectUserByUserId" resultType="zzk.entity.User">
        select *
        from user_info
        where id = #{author_id}
    </select>
    <select id="selectCommentByBlogId" resultMap="commentMap">
        select *
        from comment
        where blog_id = #{id}
    </select>
    <select id="selectBlogById" resultMap="blogMap">
        select *
        from blog
        where id = #{id}
    </select>
</mapper>
